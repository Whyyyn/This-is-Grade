{
  "name": "this-is-grade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "test": "node --test",
    "dev": "npm run build:css && sh -c 'tailwindcss -i ./src/styles.css -o ./public/styles.css --watch & wrangler pages dev public; kill $!'",
    "dev:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --watch",
    "deploy": "npm run build && wrangler pages deploy public --project-name this-is-grade",
    "push:keys": "web-push generate-vapid-keys",
    "push:dev": "wrangler dev --config wrangler.push.toml --test-scheduled --env-file .dev.vars.push",
    "push:deploy": "wrangler deploy --config wrangler.push.toml"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  }
}
